# Скопируйте в .env (файл .env НЕ коммитится) или задайте переменные в окружении/секретах хостинга.
NODE_ENV=production
PORT=3000
BASE_URL=https://donate.example.com
TRUST_PROXY=true                # true, если сайт стоит за Caddy/nginx
DATA_DIR=./data                 # база SQLite, загрузки, резервные копии
SITE_TIMEZONE=Europe/Kyiv

# Владельцы (вход — по коду на почту)
OWNER_PRIMARY_EMAIL=oartem0912@gmail.com
OWNER_SECONDARY_EMAIL=amongtem151@gmail.com

# Секрет для связи с плагином: >= 32 символов. Сгенерировать: openssl rand -hex 32
PLUGIN_SECRET=

# Почта (SMTP). Для Gmail нужен «пароль приложения».
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Noroshi Donate <no-reply@example.com>"

# LiqPay (https://www.liqpay.ua) — ключи из кабинета мерчанта
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=false

# Тестовая оплата без денег. В боевом режиме держите false.
TEST_PAYMENTS=false

ORDER_PENDING_TTL_HOURS=24
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
